# URL base de la API 
API_URL=https://jsonplaceholder.typicode.com/posts

# Timeout por petición, en segundos (debe ser > 0)
API_TIMEOUT=10

# Número máximo de intentos por identificador (debe ser >= 1)
API_MAX_INTENTOS=3

# Base del backoff exponencial, en segundos (debe ser >= 0)
API_ESPERA_BASE=1
